# Gateway base URL
BIFROST_URL=http://localhost:8080

# Virtual keys created in Bifrost
BIFROST_VK_STANDARD=sk-bf-standard-key
BIFROST_VK_CONFIDENTIAL=sk-bf-confidential-key

# Optional Tavily API key for targeted freshness lookups
TAVILY_API_KEY=tvly-placeholder

# User id for budget ledger (defaults to OS username if omitted)
ZEROBURN_USER=developer
